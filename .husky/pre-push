#!/usr/bin/env sh
# Gates objetivos de qualidade. Bloqueia o push se qualquer um reprovar.
#
# Gate 1 · Funcional      → 12 asserções (filtros, ordenação por teclado, CSV, console limpo)
# Gate 2 · Acessibilidade → axe-core, 0 violações WCAG 2.0/2.1/2.2 A+AA + best-practice, em 3 estados
# Gate 3 · Semântica      → Semantic HTML Score = 100/100
# Gate 4 · Lighthouse CI  → a11y/BP/SEO = 100, perf >= 99, LCP <= 1.5s, CLS <= 0.02, TBT <= 100ms
#
# Emergência (usar com parcimônia e justificar no PR):
#   SKIP_GATES=1 git push
# Preferir sempre:  git push --no-verify  NÃO é permitido pela política do repositório.

set -e

if [ "$SKIP_GATES" = "1" ]; then
  echo "⚠  SKIP_GATES=1 — gates ignorados deliberadamente. Justifique no PR."
  exit 0
fi

echo "▶ Executando gates de qualidade antes do push…"
echo "  (para pular em emergência: SKIP_GATES=1 git push)"
echo

if [ ! -d node_modules ]; then
  echo "✗ node_modules ausente. Rode: npm ci"
  exit 1
fi

if [ ! -d "$HOME/.cache/ms-playwright" ] && [ -z "$PLAYWRIGHT_BROWSERS_PATH" ]; then
  echo "✗ Navegador do Playwright ausente. Rode: npx playwright install chromium"
  exit 1
fi

npm run gates
