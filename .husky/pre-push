#!/usr/bin/env sh
# Gates objetivos de qualidade. Bloqueia o push se qualquer um reprovar.
#
# Gate 1 · Build & Schema  → data/tributos.json válido e public/ sincronizado com o build
# Gate 2 · Estilo          → higiene de arquivo (indentação, espaços, LF, EOF) + Prettier + ESLint
# Gate 3 · Funcional       → 12 asserções (filtros, ordenação por teclado, CSV, console limpo)
# Gate 4 · Responsividade  → 320/375/390/768/1024/1280/1440/1920px + 3 dispositivos reais:
#                            zero overflow, alvos de toque >= 44px, sem sobreposição
# Gate 5 · Acessibilidade  → axe-core, 0 violações WCAG 2.0/2.1/2.2 A+AA + best-practice, 3 estados
# Gate 6 · Semântica       → Semantic HTML Score = 100/100
# Gate 7 · Duplicação      → jscpd: <= 0,4% de linhas duplicadas e nenhum clone >= 12 linhas
# Gate 8 · Lighthouse CI   → a11y/BP/SEO = 100, perf >= 99, LCP <= 1.5s, CLS <= 0.02, TBT <= 100ms
#
# Emergência (usar com parcimônia e justificar no PR):
#   SKIP_GATES=1 git push
# Preferir sempre:  git push --no-verify  NÃO é permitido pela política do repositório.

set -e

if [ "$SKIP_GATES" = "1" ]; then
  echo "⚠  SKIP_GATES=1 — gates ignorados deliberadamente. Justifique no PR."
  exit 0
fi

echo "▶ Executando gates de qualidade antes do push…"
echo "  (para pular em emergência: SKIP_GATES=1 git push)"
echo

if [ ! -d node_modules ]; then
  echo "✗ node_modules ausente. Rode: npm ci"
  exit 1
fi

if [ ! -d "$HOME/.cache/ms-playwright" ] && [ -z "$PLAYWRIGHT_BROWSERS_PATH" ]; then
  echo "✗ Navegador do Playwright ausente. Rode: npx playwright install chromium"
  exit 1
fi

npm run gates
