{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.99 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],

        "first-contentful-paint": ["error", { "maxNumericValue": 1200, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1500, "aggregationMethod": "median" }],
        "total-blocking-time": ["error", { "maxNumericValue": 100, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
        "speed-index": ["error", { "maxNumericValue": 1500, "aggregationMethod": "median" }],
        "interactive": ["error", { "maxNumericValue": 1800, "aggregationMethod": "median" }],
        "max-potential-fid": "off",

        "color-contrast": ["error", { "minScore": 1 }],
        "heading-order": ["error", { "minScore": 1 }],
        "label": ["error", { "minScore": 1 }],
        "table-duplicate-name": ["error", { "minScore": 1 }],
        "th-has-data-cells": ["error", { "minScore": 1 }],
        "html-has-lang": ["error", { "minScore": 1 }],
        "html-lang-valid": ["error", { "minScore": 1 }],
        "meta-description": ["error", { "minScore": 1 }],
        "document-title": ["error", { "minScore": 1 }],
        "errors-in-console": ["error", { "minScore": 1 }],
        "render-blocking-resources": ["error", { "minScore": 1 }],
        "unused-css-rules": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off",

        "total-byte-weight": ["error", { "maxNumericValue": 400000 }],
        "dom-size": ["error", { "maxNumericValue": 1200 }],
        "network-requests": "off",

        "cls-culprits-insight": ["error", { "minScore": 1 }],
        "forced-reflow-insight": ["error", { "minScore": 1 }],
        "viewport-insight": ["error", { "minScore": 1 }],
        "document-latency-insight": "off",
        "cache-insight": "off",
        "dom-size-insight": "off",
        "network-dependency-tree-insight": "off",
        "third-party-facades": "off",
        "legacy-javascript": "off"
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./audit/reports/lhci" }
  }
}
