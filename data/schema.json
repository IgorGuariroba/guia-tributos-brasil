{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://igorguariroba.github.io/guia-tributos-brasil/data/schema.json",
  "title": "Catálogo de tributos, contribuições, taxas e encargos do Brasil",
  "description": "Fonte da verdade consumida por audit/build.mjs para gerar public/index.html e public/api/*.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "sigla",
      "nome",
      "tipo",
      "esfera",
      "contexto",
      "descricao",
      "status",
      "atualizado_em",
      "fontes",
      "fundamento",
      "sujeito_passivo",
      "periodicidade",
      "guia"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Identificador estável do item. Não deve ser reatribuído nem reaproveitado após remoção do item.",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "sigla": {
        "type": "string",
        "minLength": 1
      },
      "nome": {
        "type": "string",
        "minLength": 1
      },
      "tipo": {
        "type": "string",
        "minLength": 1
      },
      "esfera": {
        "type": "string",
        "minLength": 1
      },
      "contexto": {
        "type": "string",
        "minLength": 1,
        "description": "Categorias separadas por ' / '; cada token é filtrável de forma atômica."
      },
      "descricao": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "Vigente",
          "Em transição",
          "Em implantação",
          "Varia por ente",
          "Não instituído",
          "Histórico"
        ]
      },
      "nota_status": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "default": []
      },
      "atualizado_em": { "type": "string", "format": "date" },
      "fontes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rotulo", "url"],
          "properties": {
            "rotulo": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      },
      "sujeito_passivo": { "type": "string", "minLength": 1 },
      "periodicidade": { "type": "string", "minLength": 1 },
      "guia": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rotulo"],
            "properties": {
              "id": { "type": "string" },
              "rotulo": { "type": "string", "minLength": 1 }
            }
          }
        ]
      },
      "fundamento": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lei", "url"],
          "properties": {
            "lei": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "observacao": { "type": "string" }
          }
        }
      }
    }
  }
}
